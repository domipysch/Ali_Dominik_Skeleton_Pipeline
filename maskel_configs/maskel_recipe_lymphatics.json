{
  "schema_version": 8,
  "spacing": [3.0, 0.43, 0.43],
  "preprocessing": {
    "opening_radius": 0,
    "closing_iterations": 2,
    "fill_holes": true,
    "max_hole_diameter": 10.0
  },
  "postprocessing": {
    "junction_cleanup": true,
    "cleanup_threshold_factor": 2.5,
    "prune_spurs": true,
    "min_spur_length": 80.0,
    "spur_iterations": 2
  },
  "feature_extraction": {
    "summary": true,
    "branches": true,
    "nodes": true,
    "fractal_dimension": true,
    "radius_features": true
  },
  "output": {
    "write_summary_csv": true,
    "write_branch_csv": true,
    "write_node_csv": true,
    "write_graphml": false,
    "write_networkx_graph": false,
    "write_skeleton_mask": true,
    "write_skeleton_radii": false
  }
}